{
  "name": "simulacro-examen",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch scripts/dev-api.ts",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
